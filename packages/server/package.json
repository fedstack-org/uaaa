    "build:watch": "tsc -w",
    "prepack": "run build"
  },
  "files": [
    "lib"
  ],
  "bin": {
    "uaaa-server": "lib/cli/index.js"
  },
  "dependencies": {
    "@hono/arktype-validator": "^2.0.1",
    "@hono/node-server": "^1.19.0",
    "@simplewebauthn/server": "^13.1.2",
    "@uaaa/core": "workspace:^",
    "arktype": "^2.1.20",
    "bcrypt": "^6.0.0",
    "clipanion": "^4.0.0-rc.4",
    "destr": "^2.0.5",
    "hono": "^4.9.2",
    "hookable": "^5.5.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "ms": "^2.1.3",
    "nanoid": "^5.1.5",
    "nodemailer": "^7.0.5",
    "pino": "^9.9.0",
    "totp-generator": "^1.0.0",
    "typanion": "^3.14.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.1",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2"
  }
