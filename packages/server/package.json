{
  "name": "@uaaa/server",
  "type": "module",
  "main": "lib/index.js",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently yarn:build:watch yarn:dev:server",
    "dev:server": "node --watch ./lib/cli/index.js serve --config ../../local/config.json",
