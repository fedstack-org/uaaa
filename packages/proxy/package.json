{
  "name": "@uaaa/proxy",
  "type": "module",
  "main": "lib/index.js",
  "version": "0.4.5",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently yarn:build:watch yarn:dev:server",
    "dev:server": "node --watch ./lib/cli/index.js serve --config ../../local/config.proxy.json",
    "build": "tsc",
    "build:watch": "tsc -w",
    "prepack": "run build"
  },
  "files": [
    "lib"
  ],
  "bin": {
    "uaaa-proxy": "lib/cli/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/http-proxy": "^11.4.1",
    "@fastify/sensible": "^6.0.4",
    "@fastify/session": "^11.1.1",
    "@hono/node-server": "^1.19.11",
    "@uaaa/core": "workspace:^",
    "arktype": "^2.2.0",
    "clipanion": "^4.0.0-rc.4",
    "fastify": "^5.8.1",
    "hono": "^4.12.5",
    "hookable": "^6.0.1",
    "jose": "^6.2.0",
    "pino": "^10.3.1",
    "typanion": "^3.14.0"
  },
  "devDependencies": {
    "@uaaa/server": "workspace:^",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
